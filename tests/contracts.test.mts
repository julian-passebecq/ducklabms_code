import {test} from 'node:test';import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';
import {topologicalOrder,isExecutionFresh,requireModuleCompatibility} from '../packages/contracts/src/index.ts';
import {createCaseNotebook,practiceView,withSource,sourceOf,importNotebook,exportNotebook,restoreNotebook,recordExecution,setBlockKernel,attachServerEvidence,addCell} from '../apps/web/src/notebook.ts';
import {moveNotebookGroup,runnableBlockIds} from '../packages/notebook-core/src/v2/model.ts';
const c=JSON.parse(readFileSync(new URL('../content/cases/retail-medallion.json',import.meta.url),'utf8'));
test('graph validates unknown, duplicate and cycle; supports independent tasks',()=>{assert.deepEqual(topologicalOrder([{id:'c',depends_on:['a','b']},{id:'b',depends_on:[]},{id:'a',depends_on:[]}]),['a','b','c']);for(const s of [[{id:'a',depends_on:['b']}],[{id:'a',depends_on:['a']}],[{id:'a',depends_on:[]},{id:'a',depends_on:[]}]])assert.throws(()=>topologicalOrder(s))});
test('case notebook has shared cell identity across all layouts',()=>{const n=createCaseNotebook(c);assert.equal(n.blocks.filter(b=>b.role==='code').length,4);assert.ok(n.views.length>=5);for(const v of n.views)for(const id of v.blockIds)assert.ok(n.blocks.some(b=>b.id===id));const updated=withSource(n,c.steps[0].id,'SELECT 42');for(const v of updated.views){const b=updated.blocks.find(b=>b.id===c.steps[0].id);assert.equal(sourceOf(updated,b),'SELECT 42')}});
test('geometry cannot change notebook execution order',()=>{const n=createCaseNotebook(c);const v=n.views.find(v=>v.id==='notebook');const expected=runnableBlockIds(v,n.blocks);const moved={...v,layout:v.layout.map(i=>({...i,y:100-i.y}))};assert.deepEqual(runnableBlockIds(moved,n.blocks),expected)});
test('semantic move is explicit and includes its output',()=>{const n=createCaseNotebook(c);const v=n.views.find(v=>v.id==='notebook');const moved=moveNotebookGroup(v,n.blocks,c.steps[1].id,-1);assert.notDeepEqual(moved.blockIds,v.blockIds);assert.equal(new Set(moved.blockIds).size,v.blockIds.length)});
test('practice canvas honors custom geometry',()=>{let n=createCaseNotebook(c);const v=practiceView(n,c.steps[0].id);const layout=v.layout.map(i=>({...i,h:i.h+2}));n={...n,practiceLayouts:{[c.steps[0].id]:layout}};assert.deepEqual(practiceView(n,c.steps[0].id).layout,layout)});
test('project restore sanitizes blocks and keeps source',()=>{const n=createCaseNotebook(c);const restored=restoreNotebook(JSON.parse(JSON.stringify(n)));assert.equal(restored.blocks.length,n.blocks.length);assert.equal(sourceOf(restored,restored.blocks[0]),c.steps[0].code);assert.deepEqual(restored.executions,{})});
test('kernel switch updates export type without losing source',()=>{const n=createCaseNotebook(c);const next=setBlockKernel(n,c.steps[0].id,'python');assert.equal(next.blocks[0].type,'python');assert.equal(sourceOf(next,next.blocks[0]),sourceOf(n,n.blocks[0]))});
test('ipynb roundtrip preserves source metadata attachments and inert HTML',()=>{const doc={nbformat:4,nbformat_minor:5,metadata:{custom:{keep:1},kernelspec:{name:'python3',language:'python',display_name:'Python'}},cells:[{cell_type:'markdown',id:'note',metadata:{tags:['keep']},source:['hello'],attachments:{'test.txt':{'text/plain':'text'}}},{cell_type:'code',id:'code',metadata:{custom:'value'},execution_count:9,source:['x = 1\n','x'],outputs:[{output_type:'display_data',metadata:{},data:{'text/html':'<script>bad()</script>','text/plain':'safe'}}]}]};const n=importNotebook(JSON.stringify(doc),'test.ipynb');assert.equal(Object.keys(n.executions).length,0);const out=exportNotebook(n);assert.equal(out.metadata.custom.keep,1);const code=out.cells.find(c=>c.id==='code');assert.equal(code.metadata.custom,'value');assert.equal(code.source.join(''),'x = 1\nx');assert.equal(code.outputs[0].data['text/html'],'<script>bad()</script>');const note=out.cells.find(c=>c.id==='note');assert.equal(note.attachments['test.txt']['text/plain'],'text')});
test('unsupported notebook magics stay read-only',()=>{const n=importNotebook(JSON.stringify({nbformat:4,nbformat_minor:5,metadata:{},cells:[{cell_type:'code',id:'a',metadata:{},source:['%%bash\necho no'],outputs:[],execution_count:null}]}),'unsupported.ipynb');assert.equal(n.blocks[0].readOnly,true)});
test('root custom Spark kernel survives ipynb export and import',()=>{const n=createCaseNotebook(c);const out=exportNotebook(n);const rt=importNotebook(JSON.stringify(out),'case.ipynb');assert.ok(rt.blocks.some(b=>b.kernel==='sparklab'));assert.ok(rt.blocks.some(b=>b.stepId===c.steps[1].id))});
test('output evidence is attached to its originating cell only',()=>{const n=createCaseNotebook(c);const run={id:'r',cell_id:c.steps[0].id,notebook_id:n.id,status:'success',sequence:1,result:{columns:['x'],rows:[{x:2}],total_rows:1,truncated:false}};const next=recordExecution(n,run);assert.ok(next.executions[c.steps[0].id]);assert.equal(next.executions[c.steps[1].id],undefined);assert.equal(next.executedSource[c.steps[0].id],c.steps[0].code)});
test('server evidence cannot attach to another notebook',()=>{const n=createCaseNotebook(c);const next=attachServerEvidence(n,[{cell_id:c.steps[0].id,notebook_id:'other',status:'success'}]);assert.deepEqual(next.executions,{})});
test('stale or changed inputs invalidate report freshness',()=>{const run={status:'success',input_versions:{'gold.x':'v1'}};assert.equal(isExecutionFresh(run,[{name:'gold.x',fresh:true,version:'v1'}]),true);assert.equal(isExecutionFresh(run,[{name:'gold.x',fresh:false,version:'v1'}]),false);assert.equal(isExecutionFresh(run,[{name:'gold.x',fresh:true,version:'v2'}]),false);assert.equal(isExecutionFresh({status:'success'},[]),false)});
test('new cells appear in all persistent layouts',()=>{const n=addCell(createCaseNotebook(c),'markdown');const id=n.blocks.at(-1).id;for(const v of n.views)assert.ok(v.blockIds.includes(id))});
test('incompatible module contract rejected',()=>assert.throws(()=>requireModuleCompatibility({id:'x',contract_version:2})));
test('custom practice geometry survives project save and restore',()=>{const n=createCaseNotebook(c);const layout=practiceView(n,c.steps[0].id).layout.map(i=>({...i,h:i.h+1}));const doc={...n,practiceLayouts:{[c.steps[0].id]:layout}};const out=restoreNotebook(doc);assert.deepEqual(practiceView(out,c.steps[0].id).layout.map(i=>i.h),layout.map(i=>i.h))});
