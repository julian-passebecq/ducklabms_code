  "components": {
    "schemas": {
      "CreateWorkspace": {
        "properties": {
          "case_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CreateWorkspace"
      },
      "DataContext": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "columns": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Columns"
          },
          "sample_rows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Sample Rows"
          },
          "catalog_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Catalog Ref"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "columns"
        ],
        "title": "DataContext"
      },
      "ExecuteCell": {
        "properties": {
          "notebook_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Notebook Id"
          },
          "cell_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Cell Id"
          },
          "step_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Step Id"
          },
          "language": {
            "type": "string",
            "enum": [
              "sql",
              "sparklab",
              "python",
              "polars",
              "dbt"
            ],
            "title": "Language"
          },
          "code": {
            "type": "string",
            "maxLength": 40000,
            "minLength": 1,
            "title": "Code"
          },
          "output_asset": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Asset"
          },
          "profile": {
            "type": "string",
            "maxLength": 80,
            "title": "Profile",
            "default": "generic_8x8"
          },
          "aqe": {
            "type": "boolean",
            "title": "Aqe",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "notebook_id",
          "cell_id",
          "language",
          "code"
        ],
        "title": "ExecuteCell"
      },
      "ExecutionError": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "message"
        ],
        "title": "ExecutionError"
      },
      "ExerciseAttempt": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "exercise_id": {
            "type": "string",
            "title": "Exercise Id"
          },
          "exercise_version": {
            "type": "string",
            "title": "Exercise Version"
          },
          "notebook_id": {
            "type": "string",
            "title": "Notebook Id"
          },
          "cell_id": {
            "type": "string",
            "title": "Cell Id"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "source_hash": {
            "type": "string",
            "title": "Source Hash"
          },
          "source_revision": {
            "type": "integer",
            "title": "Source Revision"
          },
          "validator_version": {
            "type": "string",
            "title": "Validator Version"
          },
          "fixtures": {
            "items": {
              "$ref": "#/components/schemas/VersionRef"
            },
            "type": "array",
            "title": "Fixtures"
          },
          "language": {
            "type": "string",
            "enum": [
              "sql",
              "sparklab",
              "python",
              "polars",
              "dbt"
            ],
            "title": "Language"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "error"
            ],
            "title": "Status"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/ExerciseCheck"
            },
            "type": "array",
            "title": "Checks"
          },
          "truth": {
            "type": "string",
            "enum": [
              "real",
              "semantic-emulation",
              "simulated",
              "unsupported"
            ],
            "title": "Truth"
          },
          "runtime": {
            "$ref": "#/components/schemas/RuntimeIdentity"
          },
          "elapsed_ms": {
            "type": "number",
            "title": "Elapsed Ms"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExecutionError"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "id",
          "created_at",
          "exercise_id",
          "exercise_version",
          "notebook_id",
          "cell_id",
          "source",
          "source_hash",
          "source_revision",
          "validator_version",
          "fixtures",
          "language",
          "status",
          "checks",
          "truth",
          "runtime",
          "elapsed_ms"
        ],
        "title": "ExerciseAttempt"
      },
      "ExerciseCheck": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "visible",
              "hidden",
              "edge"
            ],
            "title": "Visibility"
          },
          "passed": {
            "type": "boolean",
            "title": "Passed"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed"
            ],
            "title": "Status"
          },
          "execution_id": {
            "type": "string",
            "title": "Execution Id"
          },
          "execution_status": {
            "type": "string",
            "title": "Execution Status"
          },
          "elapsed_ms": {
            "type": "number",
            "title": "Elapsed Ms"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "input_versions": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Input Versions"
          },
          "actual": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual"
          },
          "expected": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected"
          }
