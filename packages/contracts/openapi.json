  "components": {
    "schemas": {
      "CreateWorkspace": {
        "properties": {
          "case_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Case Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "case_id"
        ],
        "title": "CreateWorkspace"
      },
      "ExecuteCell": {
        "properties": {
          "notebook_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Notebook Id"
          },
          "cell_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Cell Id"
          },
          "step_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Step Id"
          },
          "language": {
            "type": "string",
            "enum": [
              "sql",
              "sparklab",
              "python",
              "polars",
              "dbt"
            ],
            "title": "Language"
          },
          "code": {
            "type": "string",
            "maxLength": 40000,
            "minLength": 1,
            "title": "Code"
          },
          "output_asset": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Asset"
          },
          "profile": {
            "type": "string",
            "maxLength": 80,
            "title": "Profile",
            "default": "generic_8x8"
          },
          "aqe": {
            "type": "boolean",
            "title": "Aqe",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "notebook_id",
          "cell_id",
          "language",
          "code"
        ],
        "title": "ExecuteCell"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RunWorkflow": {
        "properties": {
          "notebook_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Notebook Id",
            "default": "case-notebook"
          },
          "overrides": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Overrides"
          },
          "profile": {
            "type": "string",
            "maxLength": 80,
            "title": "Profile",
            "default": "generic_8x8"
          },
          "aqe": {
            "type": "boolean",
            "title": "Aqe",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "RunWorkflow"
      },
      "SaveNotebook": {
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Revision"
          },
          "notebook": {
            "additionalProperties": true,
            "type": "object",
            "title": "Notebook"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revision",
          "notebook"
        ],
        "title": "SaveNotebook"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}