+  return value;
+}
+export function finite(value: unknown, label: string, min = -1e15, max = 1e15): number {
+  if (typeof value !== 'number' || !Number.isFinite(value) || value < min || value > max) throw new Error(`Invalid ${label}.`);
+  return value;
