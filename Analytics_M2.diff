+export function RuntimeStudio() {
+  return <section className="an-layer"><Title eyebrow="RUNTIME BOUNDARIES / NO VM REQUIRED" title="Local first. Connect later."/><p className="an-lead">This analytics layer edits and visualizes documents. The existing notebook runtime remains separate; opening a layer does not start compute.</p><div className="an-runtime-grid">{[
