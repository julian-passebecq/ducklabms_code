          "maxItems": 200,
          "title": "Tasks",
          "type": "array"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "maxItems": 500,
          "title": "Dependencies",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "id",
        "title",
        "revision",
        "kind",
        "tasks",
        "dependencies"
      ],
      "title": "WorkflowResource",
      "type": "object"
    },
    "WorkflowTask": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "runtime": {
          "enum": [
            "local.sql",
            "local.sparklab",
            "local.python",
            "local.polars",
            "local.dbt",
            "remote.motherduck"
          ],
          "title": "Runtime",
          "type": "string"
        },
        "notebook_resource_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,100}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notebook Resource Id"
        }
      },
      "required": [
        "id",
        "label",
        "runtime",
        "notebook_resource_id"
      ],
      "title": "WorkflowTask",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "resources": {
      "items": {
        "discriminator": {
          "mapping": {
            "catalog": "#/$defs/CatalogResource",
            "data-model": "#/$defs/DataModelResource",
            "evidence": "#/$defs/EvidenceResource",
            "lineage": "#/$defs/LineageResource",
            "notebook": "#/$defs/NotebookResource",
            "workflow": "#/$defs/WorkflowResource"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/NotebookResource"
          },
          {
            "$ref": "#/$defs/CatalogResource"
          },
          {
            "$ref": "#/$defs/EvidenceResource"
          },
          {
            "$ref": "#/$defs/WorkflowResource"
          },
          {
            "$ref": "#/$defs/LineageResource"
          },
          {
            "$ref": "#/$defs/DataModelResource"
          }
        ]
      },
      "maxItems": 60,
      "title": "Resources",
      "type": "array"
    },
    "views": {
      "items": {
        "$ref": "#/$defs/ViewInstance"
      },
      "maxItems": 120,
      "title": "Views",
      "type": "array"
    },
    "panes": {
      "items": {
        "$ref": "#/$defs/Pane"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Panes",
      "type": "array"
    },
    "active_pane_id": {
      "pattern": "^[A-Za-z0-9_-]{1,100}$",
      "title": "Active Pane Id",
      "type": "string"
    },
    "persona": {
      "enum": [
        "neutral",
        "fabric",
        "warehouse"
      ],
      "title": "Persona",
      "type": "string"
    },
    "direction": {
      "enum": [
        "horizontal",
        "vertical"
      ],
      "title": "Direction",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "resources",
    "views",
    "panes",
    "active_pane_id",
    "persona",
    "direction"
  ],
  "title": "RootWorkbench",
  "type": "object"
}
