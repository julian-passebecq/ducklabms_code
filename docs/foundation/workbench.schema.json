            {
              "type": "null"
            }
          ],
          "title": "Selected Node"
        },
        "selected_edge": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,100}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected Edge"
        }
      },
      "required": [
        "id",
        "resource_id",
        "mode",
        "positions",
        "viewport",
        "selected_node",
        "selected_edge"
      ],
      "title": "ViewInstance",
      "type": "object"
    },
    "Viewport": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 100000,
          "minimum": -100000,
          "title": "X",
