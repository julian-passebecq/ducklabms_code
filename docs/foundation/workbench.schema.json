        "relationships": {
          "items": {
            "$ref": "#/$defs/Relationship"
          },
          "maxItems": 500,
          "title": "Relationships",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "id",
        "title",
        "revision",
        "kind",
        "tables",
        "relationships"
      ],
      "title": "DataModelResource",
      "type": "object"
    },
