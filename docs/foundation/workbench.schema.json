        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "kind": {
          "const": "catalog",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "title",
        "revision",
        "kind"
      ],
      "title": "CatalogResource",
      "type": "object"
    },
    "DataModelResource": {
