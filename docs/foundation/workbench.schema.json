    "WorkflowResource": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
